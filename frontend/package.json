{
  "name": "vwkanban-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "spike:build": "vite build --mode spike && node scripts/spike-size.mjs",
    "spike:e2e": "playwright test"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.65.1",
    "@replit/codemirror-vim": "6.4.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "5.1.1"
  }
}
