# Copy to .env and edit. Compose reads this file; nothing else configures the app.

# Public base URL. Its scheme sets the session cookie's Secure flag (M1).
PUBLIC_URL=http://kanban.example.com

# Database password (the db and app containers share it).
POSTGRES_PASSWORD=change-me

# First admin, created on first start if no users exist (M1).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# Show a signup form on the login page.
ALLOW_SIGNUP=false

# Host port nginx listens on.
HTTP_PORT=80

# Prebuilt images: ghcr.io/<VWK_IMAGE_OWNER>/vwkanban-{app,web}:<VWK_VERSION>.
# `docker compose up --build` builds locally instead.
VWK_IMAGE_OWNER=vwkanban
VWK_VERSION=latest
